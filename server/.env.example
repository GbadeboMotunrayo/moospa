# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=house_of_moo

# JWT Secret (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Paystack (get from https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Cloudinary (get from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail example — use App Password if 2FA is on)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=House of Moo <your_email@gmail.com>

# Admin default credentials (used by seed script)
ADMIN_EMAIL=admin@moo.com
ADMIN_PASSWORD=moo2026

# ── Telegram ─────────────────────────────────────────────────────────────────
# Public https:// origin of the live site — used to register webhooks.
PUBLIC_URL=https://houseofmoo.shop

# Shared secret proving a webhook request really came from Telegram.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Storefront bot — receives checkout hand-offs. From @BotFather.
TELEGRAM_SHOP_BOT_TOKEN=
TELEGRAM_SHOP_BOT_USERNAME=HouseOfMooBot

# Community moderator bot — SEPARATE bot, so a report against the group
# can't take checkout down with it. Also from @BotFather.
TELEGRAM_MOD_BOT_TOKEN=

# Numeric group id of the community group (starts with -100...).
# Add the mod bot to the group as an admin, then read it from /api/telegram/status logs.
TELEGRAM_GROUP_ID=

# Comma-separated numeric Telegram user ids that receive order/moderation
# alerts and can run /stats and /list. Get yours from @userinfobot.
TELEGRAM_OWNER_IDS=

# Discount code offered in exchange for opting into the marketing list.
TELEGRAM_PERK_CODE=MOOVIP

# Bank details the shop bot quotes to customers. Leave blank and the bot will
# ask the customer to wait for details rather than inventing an account number.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=House of Moo
